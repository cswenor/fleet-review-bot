# Copy to a private mode-0600 file. Never source untrusted shell text.
# Identity values are SYNTHETIC examples, not an existing installation.
GITHUB_REPOSITORY=example-org/example-project
GITHUB_APP_ID=1001
REVIEW_BOT_LOGIN=example-review[bot]
REVIEW_BOT_USER_ID=1002
BUILDER_BOT_LOGIN=example-builder[bot]
BUILDER_BOT_USER_ID=1003
REVIEW_APPROVERS=example-owner:1004
# Advisory until project calibration and live protection are accepted.
REVIEW_BOT_MODE=advisory
MERGE_LANE_ENABLED=false
MERGE_BATCH_ENABLED=false
REVIEW_MODEL=openai-codex/gpt-6.1-sol
REVIEW_THINKING=medium
RUNNER_URL=http://runner:8081
GATEWAY_URL=http://gateway:4000
STATE_ROOT=/state
WORK_ROOT=/work
SESSIONS_ROOT=/sessions
REVIEW_CONCURRENCY=2
RETENTION_DAYS=180
PORT=8080
# Supply these ONLY through the instance's private secret configuration:
# GITHUB_APP_PRIVATE_KEY_B64, GITHUB_WEBHOOK_SECRET,
# OMP_GATEWAY_TOKEN, TYPESAFE_API_KEY.
# Legacy direct-merger opt-in additionally needs Builder App credentials;
# native auto-merge/queue does not need Builder credentials in this service.
